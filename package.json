{
  "name": "cross-check",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "spike:gateway": "tsx --conditions=react-server --env-file=.env.local scripts/gateway-spike.mts",
    "check:mcp": "node --env-file=.env.local scripts/check-mcp.mjs",
    "check:context-api": "node --env-file=.env.local scripts/check-context-api.mjs",
    "check:kb-issues": "node --env-file=.env.local scripts/check-kb-issues.mjs",
    "stage1": "tsx --conditions=react-server --env-file=.env.local scripts/stage1/ask-kb.mts",
    "stage2": "tsx --conditions=react-server --env-file=.env.local scripts/stage2/run-probe.mts",
    "stage4": "tsx --conditions=react-server --env-file=.env.local scripts/stage4/compare.mts",
    "stage4:recommend": "tsx --conditions=react-server --env-file=.env.local scripts/stage4/recommend.mts",
    "coverage": "tsx --conditions=react-server --env-file=.env.local scripts/stage5/coverage.mts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.68",
    "@ai-sdk/mcp": "2.0.62",
    "@sanity/client": "8.8.0",
